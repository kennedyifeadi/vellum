# Copy this file to .env.local and fill in the values. Every value below is a
# placeholder. Lines that are commented out are optional.

# --- Database ---------------------------------------------------------------
# MongoDB connection string (MongoDB Atlas, or a local mongod). Required: any
# request that reads or writes the database fails without it. The app still
# builds and starts without it.
MONGODB_URI=mongodb://localhost:27017/vellum

# --- Auth secrets -----------------------------------------------------------
# Random strings you generate yourself, e.g. `openssl rand -base64 32`.
# JWT_SECRET signs the email OTP session cookie; NEXTAUTH_SECRET signs the
# NextAuth (Google) session. Both are required.
JWT_SECRET=replace-with-a-long-random-string
NEXTAUTH_SECRET=replace-with-a-different-long-random-string
# Public base URL of the app. Used by NextAuth for OAuth callbacks and for
# links in outgoing emails, which fall back to http://localhost:3000 if unset.
NEXTAUTH_URL=http://localhost:3000

# --- Google sign-in ---------------------------------------------------------
# OAuth 2.0 Web client from Google Cloud Console > APIs & Services >
# Credentials. Add <NEXTAUTH_URL>/api/auth/callback/google as an authorised
# redirect URI. Required for "Continue with Google".
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Google Drive picker ----------------------------------------------------
# Optional: only the "import from Google Drive" option in the upload drawer
# needs these; it reports itself as not configured without them. Both are sent
# to the browser. The client ID is an OAuth Web client ID (it can be the same
# one as above); the API key is a browser key from the same Credentials page
# with the Google Picker API enabled.
# NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# NEXT_PUBLIC_GOOGLE_API_KEY=your-google-browser-api-key

# --- Email ------------------------------------------------------------------
# Brevo (https://app.brevo.com > SMTP & API > API keys) sends the OTP, welcome
# and support emails. Optional in development: while BREVO_API_KEY is unset or
# left as the placeholder below, nothing is sent and the OTP is written to the
# server log instead. EMAIL_USER is the sender address and must be a sender
# verified in Brevo.
BREVO_API_KEY=YOUR_BREVO_API_KEY
EMAIL_USER=no-reply@example.com

# --- Storage ----------------------------------------------------------------
# Where uploads and conversion outputs are kept. Optional: STORAGE_DRIVER
# defaults to `local` (local disk). Set it to `s3` for an S3-compatible bucket,
# which then requires S3_BUCKET, S3_REGION, S3_ACCESS_KEY_ID and
# S3_SECRET_ACCESS_KEY. Production will use Cloudflare R2: STORAGE_DRIVER=s3
# with an R2 API token's key pair and the account's R2 endpoint.
# S3_REGION must be non-empty. For AWS use the bucket's region; Cloudflare
# documents `auto` as the region for R2 (not yet verified against this driver).
# S3_ENDPOINT is only for S3-compatible providers such as R2; leave it unset
# for AWS S3.
# STORAGE_DRIVER=local
# S3_BUCKET=your-bucket-name
# S3_REGION=your-bucket-region
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Client IP ----------------------------------------------------------------
# The header your reverse proxy sets to the caller's address. It keys the
# per-IP rate limit (30 requests a minute on the convert, documents and OTP
# routes) and the location shown on a sign-in session. Only name a header the
# proxy overwrites on every request: anything else can be sent by the client to
# pick its own rate-limit key. Unset (the default), no header is trusted and all
# callers share ONE rate-limit bucket, so the limit becomes site-wide.
# CLIENT_IP_HEADER_ENTRY says which address to use when the header can hold a
# list: `single` (default; a list is not trusted at all), `leftmost` or
# `rightmost`. On Railway use CLIENT_IP_HEADER=x-real-ip (see README).
# CLIENT_IP_HEADER=x-real-ip
# CLIENT_IP_HEADER_ENTRY=single

# --- Chromium -----------------------------------------------------------------
# HTML to PDF and DOCX to PDF render in Chromium with its sandbox ON. The
# sandbox is what contains a renderer that a hostile page has taken over, and
# HTML to PDF renders pages users choose. Set this to `true` ONLY if Chromium
# cannot start sandboxed on the host (the error names the sandbox), and accept
# that a Chromium exploit then runs with the app's own user and file access.
# CHROMIUM_DISABLE_SANDBOX=false
